# LLM Backend: "groq" or "ollama" or "mock"
LLM_BACKEND=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# Ollama Settings (if LLM_BACKEND=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Embedding Model
EMBEDDING_MODEL_NAME=BAAI/bge-m3
FALLBACK_EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# Reranker Model
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2

# Storage Paths
DATA_RAW_DIR=./data/raw
DATA_PROCESSED_DIR=./data/processed
DATA_GRAPHS_DIR=./data/graphs
CHROMA_PERSIST_DIR=./data/chroma_db

# Graph BFS Search Depth
GRAPH_RETRIEVAL_DEPTH=2
RERANK_TOP_K=6
